<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="TipoLoginControllerFX">
    <top>
        <VBox prefHeight="129.0" prefWidth="600.0" style="-fx-background-color: #fcc801;" BorderPane.alignment="CENTER">
            <children>
                <VBox prefHeight="94.0" prefWidth="600.0" style="-fx-background-color: #102464;">
                    <children>
                    </children>
                </VBox>
            </children>
        </VBox>
    </top>
    <left>
        <VBox alignment="CENTER" prefHeight="270.0" prefWidth="153.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="btnLoginDdpto" mnemonicParsing="false" onAction="#onActionLoginDdpto" style="-fx-background-color: #102464;" text="Director de Departamento" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <ImageView fx:id="imgDirectorDpto" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
            </children>
        </VBox>
    </left>
    <right>
        <VBox alignment="CENTER" prefHeight="270.0" prefWidth="210.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="btnLoginEstu" mnemonicParsing="false" onAction="#onActionLoginEstu" style="-fx-background-color: #102464;" text="Estudiante" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <ImageView fx:id="imgEstudiante" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
            </children>
        </VBox>
    </right>
    <center>
        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="60.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="btnLoginDCarrera" mnemonicParsing="false" onAction="#onActionLoginDCarrera" style="-fx-background-color: #102464;" text="Director de Carrera" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="btnregistro" mnemonicParsing="false" onAction="#onActionregistro" prefHeight="30.0" prefWidth="83.0" style="-fx-background-color: #102464;" text="Registro" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </center>
</BorderPane>