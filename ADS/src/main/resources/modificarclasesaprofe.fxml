<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="aplicacion.controllers.ModificarClaseDptoControllerFX">
    <top>
        <VBox prefHeight="129.0" prefWidth="600.0" style="-fx-background-color: #ca2c78;" BorderPane.alignment="CENTER">
            <children>
                <VBox prefHeight="94.0" prefWidth="600.0" style="-fx-background-color: #9c1656;">
                    <children>
                        <Button fx:id="btnVolverAdminMenu" mnemonicParsing="false" onAction="#onActionVolverAdminMenu" prefHeight="42.0" prefWidth="88.0" text="Volver">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </VBox>
    </top>
    <left>
        <VBox alignment="CENTER" prefHeight="258.0" prefWidth="306.0" BorderPane.alignment="CENTER">
            <children>
                <Label prefHeight="49.0" prefWidth="198.0" text="Digite el id de la clase a modificar:" wrapText="true">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <TextField fx:id="idClaseAModificar" onAction="#onActionBuscarClase" />

                <Button fx:id="btnBuscarClase" mnemonicParsing="false" onAction="#onActionBuscarClase" style="-fx-background-color: #5d0f39;" text="Buscar Clase" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Button fx:id="btnAñadirclasedpt" mnemonicParsing="false" onAction="#OnActionAñadirclasedpt" style="-fx-background-color: #ca2c78;" text="Añadir" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="btnEliminarclasedpt" mnemonicParsing="false" onAction="#OnActionEliminarclasedpt" style="-fx-background-color: #ca2c78;" text="Eliminar" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER" prefHeight="258.0" prefWidth="303.0" BorderPane.alignment="CENTER">
            <children>
                <Label prefHeight="49.0" prefWidth="198.0" text="Horario de la clase" wrapText="true">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <TextField fx:id="idmodificarclasehorario" />
                <Label prefHeight="49.0" prefWidth="198.0" text="Cupo Actual" wrapText="true">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <TextField fx:id="modificarclasecupo" />
                <Button fx:id="btnModificarClasedpt" mnemonicParsing="false" onAction="#OnActionModificarClasedpt" style="-fx-background-color: #ca2c78;" text="Modificar" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </center>
</BorderPane>