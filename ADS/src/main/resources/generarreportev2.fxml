                            </font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </VBox>
    </top>
    <left>
        <VBox alignment="CENTER" prefHeight="258.0" prefWidth="306.0" BorderPane.alignment="CENTER">
            <children>
                <Label prefHeight="34.0" prefWidth="184.0" text="Digite el id de la asignatura:">
                    <font>
